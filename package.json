{
  "name": "student-forms",
  "version": "1.0.0",
  "private": true,
  "description": "Конструктор форм отклика для карьерной платформы студентов",
  "repository": {
    "type": "git",
    "url": "https://github.com/scrollDynasty/student-forms.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next build && next start",
    "serve": "next start",
    "lint": "eslint . --ignore-pattern \"Современный редизайн форм откликов/**\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "next build && vitest run",
    "test:unit": "vitest run --exclude test/api.test.ts --exclude test/startup.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:e2e": "next build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "5.3.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/visitor-keys": {
      "eslint-visitor-keys": "4.2.1"
    }
  },
  "allowScripts": {
    "unrs-resolver": false,
    "esbuild": false
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
